{{ 'ol-styles.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.color_fondo }};
  }
  #shopify-section-{{ section.id }} .ol-per-titulo { font-size: {{ section.settings.tamano_titulo }}px; }
{% endstyle %}

<section class="ol-section ol-permiso">
  <div class="ol-container">
    <div class="ol-per-intro ol-reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="ol-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="ol-h2 ol-per-titulo">{{ section.settings.titulo }}</h2>
    </div>

    <div class="ol-per-transformacion ol-reveal ol-reveal-1">
      {%- for block in section.blocks -%}
        {%- if block.type == 'transformacion' -%}
          <div class="ol-per-fila" {{ block.shopify_attributes }}>
            <span class="ol-per-antes">{{ block.settings.antes }}</span>
            <span class="ol-per-flecha">→</span>
            <span class="ol-per-despues">{{ block.settings.despues }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="ol-grid ol-cols-3 ol-per-testimonios">
      {%- for block in section.blocks -%}
        {%- if block.type == 'testimonio' -%}
          <div class="ol-card ol-per-testimonio ol-reveal ol-reveal-{{ forloop.index | at_most: 4 }}" {{ block.shopify_attributes }}>
            <div class="ol-per-estrellas">★★★★★</div>
            <p class="ol-body ol-per-cita">&ldquo;{{ block.settings.cita }}&rdquo;</p>
            <p class="ol-per-firma">{{ block.settings.autor }}{% if block.settings.contexto != blank %} · {{ block.settings.contexto }}{% endif %}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .ol-per-intro { max-width: 680px; margin: 0 auto 44px; text-align: center; }
  #shopify-section-{{ section.id }} .ol-per-titulo { margin-top: 12px; }
  #shopify-section-{{ section.id }} .ol-per-transformacion { max-width: 640px; margin: 0 auto 64px; display: flex; flex-direction: column; gap: 14px; }
  #shopify-section-{{ section.id }} .ol-per-fila {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 14px;
    padding: 14px 20px; border-radius: 6px; background: var(--ol-crema-2);
  }
  #shopify-section-{{ section.id }} .ol-per-antes { color: var(--ol-texto-suave); font-size: 15px; text-align: right; }
  #shopify-section-{{ section.id }} .ol-per-despues { color: var(--ol-verde); font-weight: 700; font-size: 15px; }
  #shopify-section-{{ section.id }} .ol-per-flecha { color: var(--ol-dorado); font-weight: 700; }
  #shopify-section-{{ section.id }} .ol-per-testimonio { padding: 30px 26px; }
  #shopify-section-{{ section.id }} .ol-per-estrellas { color: var(--ol-dorado); letter-spacing: 2px; margin-bottom: 12px; }
  #shopify-section-{{ section.id }} .ol-per-cita { font-size: 16px; margin-bottom: 16px; }
  #shopify-section-{{ section.id }} .ol-per-firma { font-weight: 700; font-size: 14px; color: var(--ol-texto); }
  @media screen and (max-width: 599px) {
    #shopify-section-{{ section.id }} .ol-per-fila { grid-template-columns: 1fr; text-align: center; gap: 4px; }
    #shopify-section-{{ section.id }} .ol-per-antes { text-align: center; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Permiso (después)",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "color_fondo", "label": "Color de fondo", "default": "#FFFFFF" },
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "EL ESTADO DESPUÉS" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Por fin te sientas en tu propio sofá." },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "tamano_titulo", "label": "Tamaño del título (px)", "min": 24, "max": 56, "step": 2, "unit": "px", "default": 38 }
  ],
  "blocks": [
    {
      "type": "transformacion",
      "name": "Fila antes → después",
      "settings": [
        { "type": "text", "id": "antes", "label": "Antes", "default": "Culpa paralizante en el sofá" },
        { "type": "text", "id": "despues", "label": "Después", "default": "Descanso legítimo, sin culpa" }
      ]
    },
    {
      "type": "testimonio",
      "name": "Testimonio",
      "settings": [
        { "type": "textarea", "id": "cita", "label": "Cita", "default": "Corríamos una hora y seguía rebotando en las paredes. Ahora juega 20 minutos solo y se desploma. No sabía que estaba construyendo un súper-atleta." },
        { "type": "text", "id": "autor", "label": "Nombre", "default": "Marta" },
        { "type": "text", "id": "contexto", "label": "Contexto (raza, ciudad...)", "default": "Border Collie, teletrabajadora" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Permiso (después)",
      "blocks": [
        { "type": "transformacion", "settings": { "antes": "Culpa paralizante en el sofá", "despues": "Descanso legítimo, sin culpa" } },
        { "type": "transformacion", "settings": { "antes": "Zoom saboteado, vergüenza profesional", "despues": "Reuniones en calma, perro ocupado" } },
        { "type": "transformacion", "settings": { "antes": "Hombro y articulaciones castigados", "despues": "Cuerpo sin dolor" } },
        { "type": "transformacion", "settings": { "antes": "Fabricando un súper-atleta imparable", "despues": "Perro de verdad saciado y dormido" } },
        { "type": "testimonio", "settings": { "cita": "Corríamos una hora y seguía rebotando en las paredes. Ahora juega 20 minutos solo y se desploma.", "autor": "Marta", "contexto": "Border Collie, teletrabajadora" } },
        { "type": "testimonio", "settings": { "cita": "Ya había tirado dinero en dos lanzadores que se atascaron con la primera baba. Este lleva 4 meses sin fallar.", "autor": "Javier", "contexto": "Labrador de 3 años" } },
        { "type": "testimonio", "settings": { "cita": "Lo mejor: no le asusta el ruido. Mi perro es miedoso y lo usa desde el primer día sin problema.", "autor": "Carla", "contexto": "Pastor Alemán" } }
      ]
    }
  ]
}
{% endschema %}
