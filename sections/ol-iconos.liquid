{{ 'ol-styles.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.color_fondo }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<section class="ol-section ol-iconos">
  <div class="ol-container">
    <div class="ol-iconos-fila ol-reveal">
      {%- for block in section.blocks -%}
        {%- if block.type == 'icono' -%}
          <div class="ol-icono-item" {{ block.shopify_attributes }}>
            <span class="ol-icono-circulo">{{ block.settings.icono }}</span>
            <span class="ol-icono-texto">{{ block.settings.texto }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .ol-iconos-fila {
    display: flex; gap: 28px; justify-content: center; flex-wrap: wrap;
  }
  #shopify-section-{{ section.id }} .ol-icono-item {
    display: flex; flex-direction: column; align-items: center; gap: 10px; width: 96px; text-align: center; flex-shrink: 0;
  }
  #shopify-section-{{ section.id }} .ol-icono-circulo {
    width: 60px; height: 60px; border-radius: 50%; background: var(--ol-crema-2);
    display: flex; align-items: center; justify-content: center; font-size: 26px;
  }
  #shopify-section-{{ section.id }} .ol-icono-texto { font-size: 12.5px; font-weight: 700; color: var(--ol-texto-suave); line-height: 1.3; }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .ol-iconos-fila { flex-wrap: nowrap; overflow-x: auto; justify-content: flex-start; gap: 22px; padding-bottom: 6px; scroll-snap-type: x proximity; }
    #shopify-section-{{ section.id }} .ol-icono-item { scroll-snap-align: start; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Icon benefit strip",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "color_fondo", "label": "Background color", "default": "#FAF7F0" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top spacing (px)", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing (px)", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "icono",
      "name": "Icon",
      "settings": [
        { "type": "text", "id": "icono", "label": "Emoji / icon", "default": "🚚" },
        { "type": "text", "id": "texto", "label": "Label", "default": "Free shipping" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon benefit strip",
      "blocks": [
        { "type": "icono", "settings": { "icono": "🚚", "texto": "Free shipping $60+" } },
        { "type": "icono", "settings": { "icono": "🛡", "texto": "90-day guarantee" } },
        { "type": "icono", "settings": { "icono": "💧", "texto": "Drool-proof" } },
        { "type": "icono", "settings": { "icono": "🔋", "texto": "Hands-free play" } },
        { "type": "icono", "settings": { "icono": "🔇", "texto": "Whisper quiet" } },
        { "type": "icono", "settings": { "icono": "⭐", "texto": "4.7 rated" } }
      ]
    }
  ]
}
{% endschema %}
