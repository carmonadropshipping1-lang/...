{{ 'ol-styles.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.color_fondo }};
  }
  #shopify-section-{{ section.id }} .ol-av-titulo { font-size: {{ section.settings.tamano_titulo }}px; }
{% endstyle %}

<section class="ol-section ol-antivillano">
  <div class="ol-container">
    <div class="ol-av-intro ol-reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="ol-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="ol-h2 ol-av-titulo">{{ section.settings.titulo }}</h2>
      {%- if section.settings.cuerpo != blank -%}<p class="ol-body">{{ section.settings.cuerpo }}</p>{%- endif -%}
    </div>

    <div class="ol-av-tabla-wrap ol-reveal ol-reveal-2">
      <table class="ol-av-tabla">
        <thead>
          <tr>
            <th class="ol-av-th-vacio"></th>
            <th class="ol-av-th-destacado">{{ section.settings.columna_propia | default: 'OffLeash' }}</th>
            <th>{{ section.settings.columna_2 }}</th>
            <th>{{ section.settings.columna_3 }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            {%- if block.type == 'fila' -%}
              <tr {{ block.shopify_attributes }}>
                <th scope="row">{{ block.settings.etiqueta }}</th>
                <td class="ol-av-td-destacado">{{ block.settings.valor_propio }}</td>
                <td>{{ block.settings.valor_2 }}</td>
                <td>{{ block.settings.valor_3 }}</td>
              </tr>
            {%- endif -%}
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .ol-av-intro { max-width: 680px; margin: 0 auto 44px; text-align: center; }
  #shopify-section-{{ section.id }} .ol-av-titulo { margin: 12px 0 14px; }
  #shopify-section-{{ section.id }} .ol-av-tabla-wrap { overflow-x: auto; }
  #shopify-section-{{ section.id }} .ol-av-tabla { width: 100%; min-width: 620px; border-collapse: collapse; }
  #shopify-section-{{ section.id }} .ol-av-tabla th, #shopify-section-{{ section.id }} .ol-av-tabla td {
    padding: 15px 14px; text-align: left; border-bottom: 1px solid var(--ol-linea); font-size: 14.5px; vertical-align: middle;
  }
  #shopify-section-{{ section.id }} .ol-av-tabla thead th { font-family: var(--ol-fuente); font-weight: 700; font-size: 14px; color: var(--ol-texto-suave); }
  #shopify-section-{{ section.id }} .ol-av-tabla tbody th {
    font-weight: 700; color: var(--ol-texto); white-space: nowrap;
    position: sticky; left: 0; background: {{ section.settings.color_fondo }}; z-index: 1;
  }
  #shopify-section-{{ section.id }} .ol-av-th-vacio { position: sticky; left: 0; background: {{ section.settings.color_fondo }}; z-index: 1; }
  #shopify-section-{{ section.id }} .ol-av-th-destacado, #shopify-section-{{ section.id }} .ol-av-td-destacado {
    background: rgba(27, 67, 50, 0.06); border-left: 2px solid var(--ol-verde); border-right: 2px solid var(--ol-verde);
    font-weight: 700; color: var(--ol-verde); text-align: center;
  }
  #shopify-section-{{ section.id }} thead .ol-av-th-destacado { border-top: 2px solid var(--ol-verde); color: var(--ol-verde); font-size: 15px; }
  #shopify-section-{{ section.id }} tbody tr:last-child .ol-av-td-destacado { border-bottom: 2px solid var(--ol-verde); }
{% endstyle %}

{% schema %}
{
  "name": "Comparison table",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "color_fondo", "label": "Background color", "default": "#FAF7F0" },
    { "type": "text", "id": "eyebrow", "label": "Small text above title", "default": "NO SPIN" },
    { "type": "text", "id": "titulo", "label": "Title", "default": "Why choose OffLeash" },
    { "type": "textarea", "id": "cuerpo", "label": "Text", "default": "We compared it head-to-head, no exaggeration." },
    { "type": "header", "content": "Table columns" },
    { "type": "text", "id": "columna_propia", "label": "Your column", "default": "OffLeash" },
    { "type": "text", "id": "columna_2", "label": "Column 2", "default": "Cheap launcher" },
    { "type": "text", "id": "columna_3", "label": "Column 3", "default": "Doggy daycare" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top spacing (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "tamano_titulo", "label": "Title size (px)", "min": 24, "max": 56, "step": 2, "unit": "px", "default": 38 }
  ],
  "blocks": [
    {
      "type": "fila",
      "name": "Comparison row",
      "settings": [
        { "type": "text", "id": "etiqueta", "label": "Attribute", "default": "Drool-proof" },
        { "type": "text", "id": "valor_propio", "label": "OffLeash", "default": "✅" },
        { "type": "text", "id": "valor_2", "label": "Column 2", "default": "❌" },
        { "type": "text", "id": "valor_3", "label": "Column 3", "default": "N/A" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison table",
      "blocks": [
        { "type": "fila", "settings": { "etiqueta": "Drool-proof", "valor_propio": "✅", "valor_2": "❌", "valor_3": "N/A" } },
        { "type": "fila", "settings": { "etiqueta": "Tires the dog for real", "valor_propio": "✅", "valor_2": "⚠️ Sometimes", "valor_3": "⚠️ Depends on staff" } },
        { "type": "fila", "settings": { "etiqueta": "Hands-free", "valor_propio": "✅", "valor_2": "✅", "valor_3": "❌" } },
        { "type": "fila", "settings": { "etiqueta": "Indoor + outdoor", "valor_propio": "✅", "valor_2": "⚠️ Outdoor only", "valor_3": "❌" } },
        { "type": "fila", "settings": { "etiqueta": "Quiet", "valor_propio": "✅", "valor_2": "⚠️ Loud sensor", "valor_3": "N/A" } },
        { "type": "fila", "settings": { "etiqueta": "Battery + plug-in", "valor_propio": "✅", "valor_2": "⚠️ Battery only", "valor_3": "N/A" } },
        { "type": "fila", "settings": { "etiqueta": "Durable motor", "valor_propio": "✅", "valor_2": "❌", "valor_3": "N/A" } },
        { "type": "fila", "settings": { "etiqueta": "No training curve", "valor_propio": "✅", "valor_2": "✅", "valor_3": "✅" } },
