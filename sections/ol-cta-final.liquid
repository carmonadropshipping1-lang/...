{{ 'ol-styles.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: var(--ol-verde-oscuro);
  }
  #shopify-section-{{ section.id }} .ol-cta-titulo { font-size: {{ section.settings.tamano_titulo }}px; }
{% endstyle %}

<section class="ol-section ol-cta-final ol-on-verde">
  <div class="ol-container ol-cta-wrap ol-reveal">
    {%- if section.settings.eyebrow != blank -%}<p class="ol-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="ol-h2 ol-cta-titulo">{{ section.settings.titulo }}</h2>
    {%- if section.settings.cuerpo != blank -%}<p class="ol-body ol-cta-cuerpo">{{ section.settings.cuerpo }}</p>{%- endif -%}
    <div class="ol-cta-botones">
      {%- if section.settings.boton_texto != blank -%}
        <a href="{{ section.settings.boton_enlace | default: '#' }}" class="ol-btn ol-btn-dorado">{{ section.settings.boton_texto }}</a>
      {%- endif -%}
    </div>
    {%- if section.settings.nota != blank -%}<p class="ol-cta-nota">{{ section.settings.nota }}</p>{%- endif -%}
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .ol-cta-wrap { max-width: 720px; margin: 0 auto; text-align: center; }
  #shopify-section-{{ section.id }} .ol-cta-titulo { margin: 12px 0 18px; }
  #shopify-section-{{ section.id }} .ol-cta-cuerpo { max-width: 52ch; margin: 0 auto 32px; }
  #shopify-section-{{ section.id }} .ol-cta-nota { margin-top: 18px; font-size: 13px; color: var(--ol-dorado-claro); }
{% endstyle %}

{% schema %}
{
  "name": "OL – CTA final",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "OFFLEASH" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "El botón de apagado, sin culpa." },
    { "type": "textarea", "id": "cuerpo", "label": "Texto", "default": "Cada día que esperas es otro día de culpa en el sofá. Rompe la trampa hoy." },
    { "type": "text", "id": "boton_texto", "label": "Texto del botón", "default": "Quiero el mío" },
    { "type": "url", "id": "boton_enlace", "label": "Enlace del botón" },
    { "type": "text", "id": "nota", "label": "Nota pequeña", "default": "Envío disponible · Reto de la Baba: 90 días · Garantía extendida" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "tamano_titulo", "label": "Tamaño del título (px)", "min": 28, "max": 64, "step": 2, "unit": "px", "default": 46 }
  ],
  "presets": [ { "name": "OL – CTA final" } ]
}
{% endschema %}
