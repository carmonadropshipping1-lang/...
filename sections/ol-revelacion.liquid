{{ 'ol-styles.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.color_fondo }};
  }
  #shopify-section-{{ section.id }} .ol-rev-titulo { font-size: {{ section.settings.tamano_titulo }}px; text-align: {{ section.settings.alineacion }}; }
  #shopify-section-{{ section.id }} .ol-rev-intro { text-align: {{ section.settings.alineacion }}; }
{% endstyle %}

<section class="ol-section ol-revelacion">
  <div class="ol-container ol-rev-wrap">
    <div class="ol-rev-intro ol-reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="ol-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="ol-h2 ol-rev-titulo">{{ section.settings.titulo }}</h2>
    </div>

    <div class="ol-rev-grid">
      <div class="ol-rev-texto ol-reveal ol-reveal-1">
        {%- for block in section.blocks -%}
          {%- if block.type == 'parrafo' -%}
            <p class="ol-body ol-rev-parrafo" {{ block.shopify_attributes }}>{{ block.settings.texto | newline_to_br }}</p>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="ol-rev-cita ol-card ol-reveal ol-reveal-2">
        <span class="ol-rev-comillas">&ldquo;</span>
        <p class="ol-rev-cita-texto">{{ section.settings.cita }}</p>
        {%- if section.settings.cita_autor != blank -%}
          <p class="ol-rev-cita-autor">{{ section.settings.cita_autor }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .ol-rev-intro { max-width: 720px; margin: 0 auto 48px; }
  #shopify-section-{{ section.id }} .ol-rev-titulo { margin-top: 12px; }
  #shopify-section-{{ section.id }} .ol-rev-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 48px; align-items: start; }
  #shopify-section-{{ section.id }} .ol-rev-parrafo { font-size: 18px; margin-bottom: 20px; }
  #shopify-section-{{ section.id }} .ol-rev-parrafo:last-child { margin-bottom: 0; }
  #shopify-section-{{ section.id }} .ol-rev-cita { padding: 40px 36px; background: var(--ol-verde); position: relative; }
  #shopify-section-{{ section.id }} .ol-rev-cita:hover { transform: none; box-shadow: none; }
  #shopify-section-{{ section.id }} .ol-rev-comillas { font-family: var(--ol-fuente); font-size: 64px; color: var(--ol-dorado); line-height: 1; display: block; margin-bottom: 6px; }
  #shopify-section-{{ section.id }} .ol-rev-cita-texto { font-family: var(--ol-fuente); font-weight: 700; font-size: 26px; line-height: 1.28; color: var(--ol-crema); margin: 0 0 16px; }
  #shopify-section-{{ section.id }} .ol-rev-cita-autor { font-size: 14px; color: var(--ol-dorado-claro); margin: 0; }
  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .ol-rev-grid { grid-template-columns: 1fr; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Revelación (absolución)",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "color_fondo", "label": "Color de fondo", "default": "#FFFFFF" },
    { "type": "select", "id": "alineacion", "label": "Alineación del título", "options": [
        {"value": "left", "label": "Izquierda"}, {"value": "center", "label": "Centro"}
      ], "default": "center" },
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "LA REVELACIÓN" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "El problema no eres tú. Es biología." },
    { "type": "header", "content": "Cita destacada" },
    { "type": "textarea", "id": "cita", "label": "Texto de la cita", "default": "No estás haciendo demasiado poco por tu perro. Estás haciendo demasiado de lo incorrecto." },
    { "type": "text", "id": "cita_autor", "label": "Firma de la cita", "default": "El botón de apagado, sin culpa." },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 },
    { "type": "range", "id": "tamano_titulo", "label": "Tamaño del título (px)", "min": 24, "max": 56, "step": 2, "unit": "px", "default": 38 }
  ],
  "blocks": [
    {
      "type": "parrafo",
      "name": "Párrafo",
      "settings": [
        { "type": "textarea", "id": "texto", "label": "Texto", "default": "El ejercicio físico que le impones activa su instinto de caza y lo inunda de adrenalina y cortisol. Cuanto más lo cansas así, mejor atleta lo haces — y menos sabe apagarse." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Revelación (absolución)",
      "blocks": [
        { "type": "parrafo", "settings": { "texto": "El ejercicio físico que le impones activa su instinto de caza y lo inunda de adrenalina y cortisol. Cuanto más lo cansas así, mejor atleta lo haces — y menos sabe apagarse." } },
        { "type": "parrafo", "settings": { "texto": "Nadie te dijo que correr más con él lo convierte en un súper-atleta imparable. No es pereza dejar de hacerlo. Es el protocolo correcto." } }
      ]
    }
  ]
}
{% endschema %}
