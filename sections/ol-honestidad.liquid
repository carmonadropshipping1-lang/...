{{ 'ol-styles.css' | asset_url | stylesheet_tag }}
{{ 'ol-scripts.js' | asset_url | script_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.color_fondo }};
  }
  #shopify-section-{{ section.id }} .ol-hon-titulo { font-size: {{ section.settings.tamano_titulo }}px; }
{% endstyle %}

<section class="ol-section ol-honestidad" id="faqs">
  <div class="ol-container ol-hon-wrap">
    <div class="ol-hon-intro ol-reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="ol-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="ol-h2 ol-hon-titulo">{{ section.settings.titulo }}</h2>
      {%- if section.settings.cuerpo != blank -%}<p class="ol-body">{{ section.settings.cuerpo }}</p>{%- endif -%}
    </div>

    <div class="ol-hon-lista ol-reveal ol-reveal-1">
      {%- for block in section.blocks -%}
        {%- if block.type == 'pregunta' -%}
          <div class="ol-faq-item" data-abierto="false" {{ block.shopify_attributes }}>
            <button type="button" class="ol-faq-pregunta" aria-expanded="false">
              <span>{{ block.settings.pregunta }}</span>
              <span class="ol-faq-icono">+</span>
            </button>
            <div class="ol-faq-respuesta">
              <div class="ol-faq-respuesta-interior">
                <p class="ol-body">{{ block.settings.respuesta | newline_to_br }}</p>
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .ol-hon-intro { max-width: 680px; margin: 0 auto 40px; text-align: center; }
  #shopify-section-{{ section.id }} .ol-hon-titulo { margin: 12px 0 14px; }
  #shopify-section-{{ section.id }} .ol-hon-lista { max-width: 760px; margin: 0 auto; }
{% endstyle %}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "color_fondo", "label": "Background color", "default": "#FFFFFF" },
    { "type": "text", "id": "eyebrow", "label": "Small text above title", "default": "NO SPIN, JUST FACTS" },
    { "type": "text", "id": "titulo", "label": "Title", "default": "Frequently asked questions" },
    { "type": "textarea", "id": "cuerpo", "label": "Text", "default": "We'd rather tell you the truth before you buy than after." },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top spacing (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "tamano_titulo", "label": "Title size (px)", "min": 24, "max": 56, "step": 2, "unit": "px", "default": 38 }
  ],
  "blocks": [
    {
      "type": "pregunta",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "pregunta", "label": "Question", "default": "Will it jam on my dog's drool?" },
        { "type": "textarea", "id": "respuesta", "label": "Answer", "default": "That's the #1 question we get, because it killed the launchers you tried before. Our dual textured flywheels are engineered to grip wet, muddy, or slobbery balls without jamming or stalling out." }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "pregunta", "settings": { "pregunta": "Will it jam on my dog's drool?", "respuesta": "That's the #1 question we get, because it's the reason your last launcher died. Our dual textured flywheels are engineered to grip wet, muddy, or slobbery balls without jamming or stalling out — even after hours of nonstop fetch." } },
        { "type": "pregunta", "settings": { "pregunta": "Will it break after a few weeks?", "respuesta": "It runs on sustained-duty DC motors, not toy-grade motorcitos. It also ships with an extended 12–24 month warranty. This isn't a fragile novelty — it's a tool you buy once." } },
        { "type": "pregunta", "settings": { "pregunta": "Will the noise scare my dog?", "respuesta": "It runs quiet — no beeping sensor or loud motor sound like some other brands. If your dog is still uneasy, our tranquility guarantee covers a full refund." } },
        { "type": "pregunta", "settings": { "pregunta": "Will my dog learn to reload it on their own?", "respuesta": "Honestly: it takes a little training, it's not instant magic. That's why every order includes the **7-Day Self-Reload Protocol**, a step-by-step video guide." } },
        { "type": "pregunta", "settings": { "pregunta": "My dog is a herding breed — will they block the sensor?", "respuesta": "It can happen — some herding breeds instinctively plant themselves in front of the launcher. We won't promise magic: the included guide walks you through the exact workaround." } },
        { "type": "pregunta", "settings": { "pregunta": "I already wasted money on a launcher that failed. Why trust this one?", "respuesta": "You don't pay if it fails. It's that simple — all the risk is on us, not you." } },
        { "type": "pregunta", "settings": { "pregunta": "Is it a shortcut for actually walking my dog?", "respuesta": "It's a supplement, not a replacement — think of it as extra, hands-free exercise on top of your normal routine, for the days your dog has more energy than you do." } }
      ]
    }
  ]
}
{% endschema %}
