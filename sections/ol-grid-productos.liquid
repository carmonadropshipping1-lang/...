{{ 'ol-styles.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.color_fondo }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<section class="ol-section ol-grid-prod" id="ol-shop">
  <div class="ol-container">
    {%- if section.settings.titulo != blank -%}
      <h2 class="ol-h2 ol-grid-prod-titulo ol-reveal">{{ section.settings.titulo }}</h2>
    {%- endif -%}
    <div class="ol-grid ol-cols-3 ol-grid-prod-tarjetas">
      {%- for block in section.blocks -%}
        {%- if block.type == 'tarjeta' -%}
          <a href="{{ block.settings.enlace | default: '#' }}" class="ol-card ol-tarjeta-prod ol-reveal ol-reveal-{{ forloop.index | at_most: 4 }}" {{ block.shopify_attributes }}>
            <div class="ol-tarjeta-prod-imagen">
              {%- if block.settings.badge != blank -%}<span class="ol-tarjeta-prod-badge">{{ block.settings.badge }}</span>{%- endif -%}
              {%- if block.settings.imagen != blank -%}
                <img src="{{ block.settings.imagen | image_url: width: 800 }}" alt="{{ block.settings.imagen.alt | default: block.settings.nombre | escape }}" loading="lazy">
              {%- else -%}
                <div class="ol-placeholder" style="aspect-ratio:1/1;"><span>{{ block.settings.nombre }}</span></div>
              {%- endif -%}
            </div>
            <p class="ol-tarjeta-prod-nombre">{{ block.settings.nombre }}</p>
            <div class="ol-tarjeta-prod-precio">
              <span class="ol-tarjeta-prod-precio-actual">{{ block.settings.precio }}</span>
              {%- if block.settings.precio_anterior != blank -%}<span class="ol-tarjeta-prod-precio-anterior">{{ block.settings.precio_anterior }}</span>{%- endif -%}
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .ol-grid-prod-titulo { text-align: center; margin-bottom: 36px; }
  #shopify-section-{{ section.id }} .ol-tarjeta-prod { display: block; text-decoration: none; color: inherit; padding: 18px; }
  #shopify-section-{{ section.id }} .ol-tarjeta-prod-imagen { position: relative; aspect-ratio: 1/1; border-radius: 4px; overflow: hidden; margin-bottom: 16px; background: var(--ol-crema-2); }
  #shopify-section-{{ section.id }} .ol-tarjeta-prod-imagen img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ section.id }} .ol-tarjeta-prod-badge {
    position: absolute; top: 12px; left: 12px; background: var(--ol-dorado); color: var(--ol-verde-oscuro);
    font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; padding: 5px 10px; border-radius: 999px; z-index: 1;
  }
  #shopify-section-{{ section.id }} .ol-tarjeta-prod-nombre { font-weight: 700; margin: 0 0 6px; }
  #shopify-section-{{ section.id }} .ol-tarjeta-prod-precio { display: flex; gap: 10px; align-items: baseline; }
  #shopify-section-{{ section.id }} .ol-tarjeta-prod-precio-actual { font-weight: 800; color: var(--ol-verde); font-family: var(--ol-fuente); }
  #shopify-section-{{ section.id }} .ol-tarjeta-prod-precio-anterior { text-decoration: line-through; color: var(--ol-texto-suave); font-size: 14px; }
{% endstyle %}

{% schema %}
{
  "name": "Product grid",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "color_fondo", "label": "Background color", "default": "#FFFFFF" },
    { "type": "text", "id": "titulo", "label": "Title", "default": "The OffLeash essentials" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top spacing (px)", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing (px)", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "tarjeta",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "imagen", "label": "Image" },
        { "type": "text", "id": "badge", "label": "Badge (optional, e.g. Sale)" },
        { "type": "text", "id": "nombre", "label": "Name", "default": "OffLeash Launcher" },
        { "type": "text", "id": "precio", "label": "Price", "default": "$89.99" },
        { "type": "text", "id": "precio_anterior", "label": "Compare-at price (optional)" },
        { "type": "url", "id": "enlace", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product grid",
      "blocks": [
        { "type": "tarjeta", "settings": { "badge": "Sale", "nombre": "OffLeash Bundle + Anti-Drool Balls", "precio": "$109.99", "precio_anterior": "$138.98" } },
        { "type": "tarjeta", "settings": { "nombre": "OffLeash Launcher", "precio": "$89.99" } },
        { "type": "tarjeta", "settings": { "nombre": "Accessory Pack (balls + battery)", "precio": "$34.99" } }
      ]
    }
  ]
}
{% endschema %}
