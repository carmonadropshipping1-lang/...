{{ 'ol-styles.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.color_fondo }};
  }
  #shopify-section-{{ section.id }} .ol-of-titulo { font-size: {{ section.settings.tamano_titulo }}px; }
{% endstyle %}

<section class="ol-section ol-oferta">
  <div class="ol-container ol-of-wrap">
    <div class="ol-of-intro ol-reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="ol-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="ol-h2 ol-of-titulo">{{ section.settings.titulo }}</h2>
      {%- if section.settings.ancla != blank -%}<p class="ol-body ol-of-ancla">{{ section.settings.ancla }}</p>{%- endif -%}
    </div>

    <div class="ol-of-grid">
      <div class="ol-of-stack ol-card ol-reveal ol-reveal-1">
        <h3 class="ol-h3 ol-of-stack-titulo">{{ section.settings.stack_titulo }}</h3>
        <ul class="ol-of-lista">
          {%- for block in section.blocks -%}
            {%- if block.type == 'item' -%}
              <li {{ block.shopify_attributes }}>
                <div>
                  <p class="ol-of-item-nombre">{{ block.settings.nombre }}</p>
                  {%- if block.settings.funcion != blank -%}<p class="ol-of-item-funcion">{{ block.settings.funcion }}</p>{%- endif -%}
                </div>
                <span class="ol-of-item-valor">{{ block.settings.valor }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        <div class="ol-of-totales">
          <div class="ol-of-total-fila">
            <span>{{ section.settings.valor_total_texto }}</span>
            <span class="ol-of-tachado">{{ section.settings.valor_total }}</span>
          </div>
          <div class="ol-of-total-fila ol-of-precio-hoy">
            <span>{{ section.settings.precio_hoy_texto }}</span>
            <span>{{ section.settings.precio_hoy }}</span>
          </div>
        </div>
        {%- if section.settings.boton_texto != blank -%}
          <a href="{{ section.settings.boton_enlace | default: '#' }}" class="ol-btn ol-btn-primario ol-of-boton">{{ section.settings.boton_texto }}</a>
        {%- endif -%}
      </div>

      <div class="ol-of-garantia ol-card ol-reveal ol-reveal-2">
        <span class="ol-badge">{{ section.settings.garantia_badge }}</span>
        <h3 class="ol-h3 ol-of-garantia-titulo">{{ section.settings.garantia_titulo }}</h3>
        <p class="ol-body">{{ section.settings.garantia_texto | newline_to_br }}</p>
      </div>
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .ol-of-intro { max-width: 680px; margin: 0 auto 48px; text-align: center; }
  #shopify-section-{{ section.id }} .ol-of-titulo { margin: 12px 0 14px; }
  #shopify-section-{{ section.id }} .ol-of-ancla { font-weight: 700; color: var(--ol-verde); }
  #shopify-section-{{ section.id }} .ol-of-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 32px; align-items: start; max-width: 1040px; margin: 0 auto; }
  #shopify-section-{{ section.id }} .ol-of-stack, #shopify-section-{{ section.id }} .ol-of-garantia { padding: 36px; }
  #shopify-section-{{ section.id }} .ol-of-stack-titulo { margin-bottom: 20px; }
  #shopify-section-{{ section.id }} .ol-of-lista { list-style: none; margin: 0 0 24px; padding: 0; }
  #shopify-section-{{ section.id }} .ol-of-lista li { display: flex; justify-content: space-between; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--ol-linea); }
  #shopify-section-{{ section.id }} .ol-of-item-nombre { font-weight: 700; margin: 0; }
  #shopify-section-{{ section.id }} .ol-of-item-funcion { margin: 4px 0 0; font-size: 14px; color: var(--ol-texto-suave); }
  #shopify-section-{{ section.id }} .ol-of-item-valor { font-weight: 700; white-space: nowrap; color: var(--ol-texto-suave); }
  #shopify-section-{{ section.id }} .ol-of-totales { border-top: 2px solid var(--ol-verde); padding-top: 16px; margin-bottom: 24px; }
  #shopify-section-{{ section.id }} .ol-of-total-fila { display: flex; justify-content: space-between; padding: 6px 0; }
  #shopify-section-{{ section.id }} .ol-of-tachado { text-decoration: line-through; color: var(--ol-texto-suave); }
  #shopify-section-{{ section.id }} .ol-of-precio-hoy { font-size: 22px; font-weight: 800; color: var(--ol-verde); font-family: var(--ol-fuente); }
  #shopify-section-{{ section.id }} .ol-of-boton { width: 100%; }
  #shopify-section-{{ section.id }} .ol-of-garantia { background: var(--ol-verde); color: var(--ol-crema); }
  #shopify-section-{{ section.id }} .ol-of-garantia:hover { transform: none; box-shadow: none; }
  #shopify-section-{{ section.id }} .ol-of-garantia p { color: rgba(250,247,240,0.85); }
  #shopify-section-{{ section.id }} .ol-of-garantia-titulo { color: var(--ol-crema); margin: 18px 0 14px; font-size: 24px; }
  @media screen and (max-width: 899px) {
    #shopify-section-{{ section.id }} .ol-of-grid { grid-template-columns: 1fr; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Oferta y garantía",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "color_fondo", "label": "Color de fondo", "default": "#FAF7F0" },
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "LA OFERTA" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Todo lo que necesitas para romper la trampa." },
    { "type": "text", "id": "ancla", "label": "Frase de anclaje", "default": "Menos que dos días de guardería canina — para siempre." },
    { "type": "header", "content": "Stack de valor" },
    { "type": "text", "id": "stack_titulo", "label": "Título del stack", "default": "Qué incluye" },
    { "type": "text", "id": "valor_total_texto", "label": "Etiqueta valor total", "default": "Valor total" },
    { "type": "text", "id": "valor_total", "label": "Valor total (tachado)", "default": "300 €" },
    { "type": "text", "id": "precio_hoy_texto", "label": "Etiqueta precio de hoy", "default": "Precio hoy" },
    { "type": "text", "id": "precio_hoy", "label": "Precio de hoy", "default": "99 €" },
    { "type": "text", "id": "boton_texto", "label": "Texto del botón", "default": "Quiero el mío" },
    { "type": "url", "id": "boton_enlace", "label": "Enlace del botón (página de producto)" },
    { "type": "header", "content": "Garantía" },
    { "type": "text", "id": "garantia_badge", "label": "Insignia", "default": "🛡 GARANTÍA ESTRELLA" },
    { "type": "text", "id": "garantia_titulo", "label": "Título de la garantía", "default": "El Reto de la Baba" },
    { "type": "textarea", "id": "garantia_texto", "label": "Texto de la garantía", "default": "Deja que tu perro empape la pelota en toda la baba y el barro que quiera. Si el motor se atasca, resbala o se frena una sola vez en 90 días, te devolvemos cada céntimo y te quedas con las pelotas." },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "tamano_titulo", "label": "Tamaño del título (px)", "min": 24, "max": 56, "step": 2, "unit": "px", "default": 38 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Elemento del stack",
      "settings": [
        { "type": "text", "id": "nombre", "label": "Nombre", "default": "Lanzador OffLeash" },
        { "type": "text", "id": "funcion", "label": "Para qué sirve", "default": "El núcleo: cansa a tu perro de verdad" },
        { "type": "text", "id": "valor", "label": "Valor", "default": "99 €" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Oferta y garantía",
      "blocks": [
        { "type": "item", "settings": { "nombre": "Lanzador OffLeash", "funcion": "El núcleo: cansa a tu perro de verdad", "valor": "99 €" } },
        { "type": "item", "settings": { "nombre": "Pack de pelotas anti-babas (x6)", "funcion": "Prueba que el mecanismo las traga", "valor": "29 €" } },
        { "type": "item", "settings": { "nombre": "Protocolo Auto-Recarga en 7 Días", "funcion": "Vídeo guiado: tu perro aprende a recargarlo", "valor": "49 €" } },
        { "type": "item", "settings": { "nombre": "Guía \"La Trampa del Agotamiento\"", "funcion": "El plan de saciedad completo", "valor": "39 €" } },
        { "type": "item", "settings": { "nombre": "Adaptador CA + batería de alta capacidad", "funcion": "Juego ilimitado, sin cambiar pilas", "valor": "25 €" } },
        { "type": "item", "settings": { "nombre": "Garantía extendida \"A Prueba de Vida Canina\"", "funcion": "12–24 meses de tranquilidad", "valor": "59 €" } }
      ]
    }
  ]
}
{% endschema %}
