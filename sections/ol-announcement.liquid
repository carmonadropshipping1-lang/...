{{ 'ol-styles.css' | asset_url | stylesheet_tag }}
{{ 'ol-scripts.js' | asset_url | script_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.color_fondo }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .ol-anuncio-texto {
    font-size: {{ section.settings.tamano_texto }}px;
    color: {{ section.settings.color_texto }};
  }
{% endstyle %}

<div class="ol-section ol-anuncio ol-marquesina-wrap">
  <div class="ol-marquesina-track" data-ol-duracion="{{ section.settings.velocidad }}s">
    {%- for i in (1..3) -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'mensaje' -%}
          <span class="ol-anuncio-item" {% if i == 1 %}{{ block.shopify_attributes }}{% endif %}>
            {%- if block.settings.enlace != blank -%}<a href="{{ block.settings.enlace }}" class="ol-anuncio-texto">{{ block.settings.texto }}</a>{%- else -%}<span class="ol-anuncio-texto">{{ block.settings.texto }}</span>{%- endif -%}
          </span>
          <span class="ol-anuncio-separador" aria-hidden="true">✦</span>
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% style %}
  #shopify-section-{{ section.id }} .ol-anuncio { overflow: hidden; }
  #shopify-section-{{ section.id }} .ol-marquesina-track { align-items: center; padding: 10px 0; }
  #shopify-section-{{ section.id }} .ol-anuncio-item { white-space: nowrap; padding: 0 10px; }
  #shopify-section-{{ section.id }} .ol-anuncio-texto { font-weight: 700; letter-spacing: 0.02em; text-decoration: none; color: inherit; }
  #shopify-section-{{ section.id }} .ol-anuncio-separador { opacity: 0.5; padding: 0 10px; }
{% endstyle %}

{% schema %}
{
  "name": "Announcement marquee",
  "tag": "div",
  "settings": [
    { "type": "color", "id": "color_fondo", "label": "Background color", "default": "#1B4332" },
    { "type": "color", "id": "color_texto", "label": "Text color", "default": "#FAF7F0" },
    { "type": "range", "id": "tamano_texto", "label": "Text size (px)", "min": 11, "max": 18, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "velocidad", "label": "Scroll speed (seconds per loop)", "min": 10, "max": 60, "step": 2, "unit": "s", "default": 24 },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top spacing (px)", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing (px)", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "mensaje",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "texto", "label": "Text", "default": "Free shipping over $60" },
        { "type": "url", "id": "enlace", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement marquee",
      "blocks": [
        { "type": "mensaje", "settings": { "texto": "Free shipping over $60" } },
        { "type": "mensaje", "settings": { "texto": "Built for dogs that never get tired" } }
      ]
    }
  ]
}
{% endschema %}
